 1 local calc = {}

 1 function calc.add(a, b)
 1   return a + b
   end

 1 function calc.sub(a, b)
 1   return a - b
   end

 1 function calc.mul(a, b)
 1   return a * b
   end

 1 function calc.div(a, b)
 1   if b == 0 then
*0     return nil
     end
 1   return a / b
   end

 1 return calc

